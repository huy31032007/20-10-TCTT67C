{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "20-10-tctt67c",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "GARDEN_DB",
      "database_name": "class-garden",
      "database_id": "40b20b49-6105-4cc1-84ed-c05cd4765087"
    }
  ]
}
