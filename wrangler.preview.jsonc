{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "20-10-tctt67c-preview",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "GARDEN_DB",
      "database_name": "class-garden-preview",
      "database_id": "c18e6254-a3d1-4f89-b8a1-5a07ff281495"
    }
  ]
}
